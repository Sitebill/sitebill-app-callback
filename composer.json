{
    "name": "sitebill/app-callback",
    "description": "Callback request app for Sitebill: a “Call me back” button on the site, requests go straight to the CRM. Sitebill is a real-estate CMS / SaaS platform.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://sitebillcms.com/",
    "keywords": ["sitebill", "real-estate", "cms", "callback", "crm", "leads", "plugin", "app"],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "sitebill/app-sdk": "dev-main"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/Sitebill/sitebill-app-sdk" }
    ],
    "autoload": {
        "psr-4": {
            "SitebillApps\\Sitebill\\Callback\\": "api/src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
